# URL pública del backend FastAPI (browser → API).
# Local: http://localhost:8000
# Vercel: https://tu-api.ejemplo.com  (el backend debe permitir el origen de Vercel en CORS)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Solo texto de ayuda en el placeholder del login. NUNCA el token real:
# el token lo pega el usuario y vive en localStorage del navegador.
NEXT_PUBLIC_ADMIN_TOKEN_HINT=
