# Copia este archivo a .env y rellena los valores.
# .env NUNCA se commitea (ver .gitignore).

# ─────────────────────────────────────────────────────────── LLM
# Proveedor de LLM: mock | gemini
# 'mock' corre TODO el sistema sin API key — el solver, el grafo y los
# detectores no dependen del modelo. Util para desarrollo y para demostrar
# que la logica de negocio no vive en el prompt. En la DEMO siempre 'gemini'.
LLM_PROVIDER=mock

GEMINI_API_KEY=
# OJO: gemini-2.5-flash da 404 en cuentas nuevas ("no longer available to new
# users"). Usa un modelo estable, no un alias '-latest' (puede cambiar solo).
GEMINI_MODEL=gemini-3.6-flash

# ─────────────────────────────────────────────────────── Retrieval (RAG)
# Vacio = sigue a LLM_PROVIDER. Ponerlo explicito solo para desacoplarlos
# (ej. LLM en gemini pero retrieval en mock durante desarrollo).
EMBEDDING_PROVIDER=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# 768 en vez de las 3072 nativas: recorta memoria y latencia sin perdida
# medible a esta escala de corpus. gemini-embedding-001 soporta el truncado.
EMBEDDING_DIM=768
# Indice vectorial persistente. SI se versiona con el repo (excepcion declarada
# en .gitignore): el contenedor de Railway arranca desde el repo y su disco es
# efimero, asi que sin esto cada despliegue dejaria cite_datasheet en SIN_CORPUS
# hasta reconstruirlo — 778 llamadas de embedding a Gemini en cada arranque.
# El indice recuerda con que embedder se construyo y se rehace solo si cambia.
CHROMA_PATH=data/generated/chroma
RETRIEVAL_TOP_K=4

# ─────────────────────────────────────────────────────────── Agente
# Limite de pasos del loop del agente (evita loops infinitos de tools)
MAX_AGENT_STEPS=8

# ──────────────────────────────────────────────────────────── Dominio
# Marca / dominio activo
BRAND=WEG

# ──────────────────────────────────────────────────────────── Auth
# Token compartido para las rutas de administrador (/admin/*, /demo/*).
# Genera uno con:  python -c "import secrets; print(secrets.token_urlsafe(24))"
# Vacio = el proceso NO levanta (fail-closed): un panel abierto es peor que
# ninguno.
ADMIN_TOKEN=

# ──────────────────────────────────────────────────────────── CORS
# Origenes permitidos para el front (Next.js en dev corre en :3000). Lista
# separada por comas. En prod, añade el dominio de Vercel:
#   CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://tu-app.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
