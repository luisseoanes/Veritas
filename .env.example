# Copia este archivo a .env y rellena los valores.
# .env NUNCA se commitea (ver .gitignore).

# Proveedor de LLM: mock | gemini
# 'mock' corre TODO el sistema sin API key — el solver, el grafo y los
# detectores no dependen del modelo. Util para desarrollo y para demostrar
# que la logica de negocio no vive en el prompt.
LLM_PROVIDER=mock

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Limite de pasos del loop del agente (evita loops infinitos de tools)
MAX_AGENT_STEPS=8

# Marca / dominio activo
BRAND=WEG

# Token compartido para las rutas de administrador (/admin/*, /demo/*).
# Genera uno con:  python -c "import secrets; print(secrets.token_urlsafe(24))"
# Vacio = el servidor niega toda ruta admin (fail-closed).
ADMIN_TOKEN=
